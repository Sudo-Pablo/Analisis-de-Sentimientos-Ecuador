# ==========================================
# Sentiment Analyzer vU — variables de entorno
# ==========================================
# Copia este archivo como `.env` en la raíz del proyecto y completa los valores.
# Nunca subas el archivo `.env` al repositorio.

# === PostgreSQL (obligatorio) ===
# En local:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sentiment_analysis
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
# En Render: DB_HOST debe ser SOLO el hostname (ej. dpg-xxxxx-a), NO la URL completa.
# Alternativa: DATABASE_URL=postgresql://user:pass@host:5432/dbname
# DB_SSLMODE=require

# === Apify (obligatorio para búsquedas en tiempo real) ===
# Token: https://console.apify.com/account/integrations
# Se usa para Facebook Search PPR, respaldo Apify y TikTok.
APIFY_TOKEN=tu_token_apify_aqui

# TikTok Apify (opcionales; defaults: más recientes + proxy Ecuador)
# TIKTOK_VIDEO_SORT=LATEST
# TIKTOK_PROXY_COUNTRY=EC

# === API / despliegue ===
# development | production
ENVIRONMENT=development
LOG_LEVEL=INFO
DATA_DIR=./data
# true solo si hay RAM suficiente (Render Standard+). En Starter déjalo false.
WARMUP_SENTIMENT=false

# Orígenes CORS permitidos (separados por coma). En producción añade la URL del frontend.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Secreto para endpoints internos / cron (POST /api/internal/scheduled-collection)
# Genera uno largo y aleatorio. Nunca lo subas al repositorio.
CRON_SECRET=cambia_este_secreto_largo_aleatorio
